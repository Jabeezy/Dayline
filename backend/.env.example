# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Postgres (Railway/Supabase/Neon free tier all work — required now, tasks
# and your Google auth tokens are both stored here so nothing resets on refresh)
DATABASE_URL=

PORT=3001

# Frontend origin, for CORS
FRONTEND_URL=http://localhost:5173
# Groq (console.groq.com) — free tier, powers the Ask/Search assistant
GROQ_API_KEY= 